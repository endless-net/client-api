{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://endlessnet.ru/contracts/release-migration/v1/inventory.schema.json",
  "title": "EndlessNet server release-control migration inventory v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "state",
    "authority",
    "source",
    "target",
    "records",
    "absent_record_classes",
    "retained_tooling",
    "cutover_gates",
    "completion"
  ],
  "properties": {
    "$schema": {"type": "string", "minLength": 1},
    "schema_version": {"const": 1},
    "state": {"const": "copy_pending"},
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "revision", "decisions", "deployment"],
      "properties": {
        "repository": {"const": "endless-net/architecture"},
        "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "decisions": {
          "type": "array",
          "const": ["D-020", "D-025"]
        },
        "deployment": {"const": "docs/ru/deployment.md"}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "revision", "role"],
      "properties": {
        "repository": {"const": "endless-net/client-api"},
        "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "role": {"const": "frozen_migration_source"}
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "baseline_revision", "role"],
      "properties": {
        "repository": {"const": "endless-net/releases"},
        "baseline_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "role": {"const": "server_release_control_owner"}
      }
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "source_path", "target_path", "sha256", "transfer", "operational_record"],
        "properties": {
          "kind": {"enum": ["candidate", "evidence", "schema", "fixture"]},
          "source_path": {"type": "string", "pattern": "^release/[0-9A-Za-z._/-]+$"},
          "target_path": {"type": "string", "pattern": "^[0-9A-Za-z._/-]+$"},
          "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "transfer": {"const": "copy_exact"},
          "operational_record": {"type": "boolean"}
        }
      }
    },
    "absent_record_classes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "candidate_provenance",
          "system_test_evidence",
          "approval",
          "released_envelope"
        ]
      }
    },
    "retained_tooling": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_path", "disposition", "target_owner"],
        "properties": {
          "source_path": {"type": "string", "pattern": "^systemtests/[0-9A-Za-z._/-]+$"},
          "disposition": {"const": "retain_until_consumer_evidence"},
          "target_owner": {"const": "endless-net/releases"}
        }
      }
    },
    "cutover_gates": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "owner", "status", "requirement", "evidence"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9_-]+$"},
          "owner": {
            "enum": [
              "endless-net/releases",
              "endless-net/system-tests",
              "endless-net/infrastructure",
              "endless-net/client-api"
            ]
          },
          "status": {"const": "pending"},
          "requirement": {"type": "string", "minLength": 1},
          "evidence": {"type": "null"}
        }
      }
    },
    "completion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "production_authorized", "reason"],
      "properties": {
        "status": {"const": "not_complete"},
        "production_authorized": {"const": false},
        "reason": {"type": "string", "minLength": 1}
      }
    }
  }
}
